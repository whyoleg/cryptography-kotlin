# Style note: prefer just's inline if/else and built-in functions (e.g. trim_start_matches) over
# shell scripting in recipes, so that the resolved command is always printed to the user.

# Show available commands
default:
    @just --list

# Build all modules (skip tests and native linking); optionally build a specific module:
#   just build core               -> builds :cryptography-core
#   just build :cryptography-core -> passes exact Gradle module path
build module="":
    ./gradlew {{ if module == "" { "build" } else if module != trim_start_matches(module, ":") { module + ":build" } else { ":cryptography-" + module + ":build" } }} -Pckbuild.skipTestTasks=true -Pckbuild.skipLinkTasks=true --continue

# Link all native binaries
link:
    ./gradlew linkAll --continue

# Update the public API ABI dump after API changes
update-abi:
    ./gradlew updateKotlinAbi --continue

# Generate API docs and build MkDocs site
docs:
    ./gradlew :mkdocsPrepare
    mkdocs build --clean --strict

# Remove test storage with data generated by provider tests (run before a fresh generate+restore cycle)
compat-clean:
    rm -rf build/test-storage

# Run provider tests (jdk, jdk-bc, webcrypto, apple, cryptokit, openssl3), optionally only for an algorithm:
#   just test-provider jdk                 -> all tests of the JDK provider
#   just test-provider jdk aes-gcm         -> only AES-GCM tests (matches `*AesGcm*` test classes)
#   just test-provider jdk --keep          -> keep generated test data (f.e. for compatibility testing or updating limitations)
#   just test-provider jdk --step restore  -> only validate all data in the test storage
[arg("step", long="step", help="Provider tests step to run (generate,restore)")]
[arg("keep", long="keep", value="true", help="Keep generated test data in the test storage")]
test-provider provider algorithm="" step="" keep="":
    ./gradlew {{ if provider == "jdk" { ":cryptography-provider-jdk:jvmTest" } else if provider == "jdk-bc" { ":cryptography-provider-jdk-bc:jvmTest" } else if provider == "webcrypto" { ":cryptography-provider-webcrypto:wasmJsNodeTest" } else if provider == "apple" { ":cryptography-provider-apple:macosArm64Test" } else if provider == "cryptokit" { ":cryptography-provider-cryptokit:macosArm64Test" } else if provider == "openssl3" { ":cryptography-provider-openssl3-prebuilt:macosArm64Test" } else { error("Unknown provider: " + provider) } }} --continue{{ if step != "" { " -Pckbuild.providerTests.step=" + step } else { "" } }}{{ if keep != "" { " -Pckbuild.teststorage.keep=true" } else { "" } }}{{ if algorithm != "" { " --tests '*" + uppercamelcase(algorithm) + "*'" } else { "" } }}
